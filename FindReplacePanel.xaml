<UserControl x:Class="AdvancedNotepad.App.FindReplacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="340">
    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
            CornerRadius="8" Padding="12" BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" PlaceholderText="Find"
                            Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Grid.Column="1" Content="↓" ToolTip="Find Next"
                           Command="{Binding FindNextCommand}" Margin="4,0,0,0"/>
                <ui:Button Grid.Column="2" Content="↑" ToolTip="Find Previous"
                           Command="{Binding FindPreviousCommand}" Margin="4,0,0,0"/>
            </Grid>

            <ui:TextBox Margin="0,8,0,0" PlaceholderText="Replace with"
                        Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="Regex" IsChecked="{Binding UseRegex}" Margin="0,0,12,0"/>
                <CheckBox Content="Case sensitive" IsChecked="{Binding CaseSensitive}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                <TextBlock Text="{Binding MatchCount, StringFormat='{}{0} matches'}"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ui:Button Content="Replace All" Command="{Binding ReplaceAllCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>