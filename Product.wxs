<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Advanced Notepad" Manufacturer="YourCompany"
           Version="1.0.0.0" UpgradeCode="9C3F2E1A-4B7D-4A2E-8C1F-1234567890AB"
           Language="1033" Compressed="true" InstallerVersion="500">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- EULA -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />

    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />
    <Icon Id="AppIcon.exe" SourceFile="app.ico" />

    <!-- Custom directory selection UI with EULA -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AdvancedNotepad">
        <Component Id="MainExecutable" Guid="1A2B3C4D-5E6F-4A7B-8C9D-0E1F2A3B4C5D">
          <File Id="AppExe" Source="$(var.AdvancedNotepad.App.TargetDir)AdvancedNotepad.exe" KeyPath="yes"/>
        </Component>
        <Component Id="NativeEngine" Guid="2B3C4D5E-6F7A-4B8C-9D0E-1F2A3B4C5D6E">
          <File Id="NativeDll" Source="$(var.AdvancedNotepad.App.TargetDir)NativeTextEngine.dll" KeyPath="yes"/>
        </Component>
        <Component Id="AppDependencies" Guid="3C4D5E6F-7A8B-4C9D-0E1F-2A3B4C5D6E7F">
          <File Source="$(var.AdvancedNotepad.App.TargetDir)*.dll"/>
        </Component>

        <!-- Context menu registry, written with resolved install path -->
        <Component Id="ShellIntegration" Guid="4D5E6F7A-8B9C-4D0E-1F2A-3B4C5D6E7F80">
          <RegistryKey Root="HKCR" Key="*\shell\AdvancedNotepad">
            <RegistryValue Type="string" Value="Open in Advanced Notepad" />
            <RegistryValue Type="string" Name="Icon"
                            Value="&quot;[INSTALLFOLDER]AdvancedNotepad.exe&quot;,0" />
          </RegistryKey>
          <RegistryKey Root="HKCR" Key="*\shell\AdvancedNotepad\command">
            <RegistryValue Type="string"
                            Value="&quot;[INSTALLFOLDER]AdvancedNotepad.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="Advanced Notepad">
        <Component Id="StartMenuShortcut" Guid="5E6F7A8B-9C0D-4E1F-2A3B-4C5D6E7F8091">
          <Shortcut Id="StartMenuShortcut" Name="Advanced Notepad"
                     Target="[INSTALLFOLDER]AdvancedNotepad.exe" WorkingDirectory="INSTALLFOLDER"
                     Icon="AppIcon.exe"/>
          <RemoveFolder Id="RemoveAppProgramMenuFolder" On="uninstall"/>
          <RegistryValue Root="HKCU" Key="Software\YourCompany\AdvancedNotepad"
                          Name="installed" Type="integer" Value="1" KeyPath="yes"/>
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="6F7A8B9C-0D1E-4F2A-3B4C-5D6E7F809102">
        <Shortcut Id="DesktopShortcut" Name="Advanced Notepad"
                   Target="[INSTALLFOLDER]AdvancedNotepad.exe" WorkingDirectory="INSTALLFOLDER"
                   Icon="AppIcon.exe"/>
        <RegistryValue Root="HKCU" Key="Software\YourCompany\AdvancedNotepad"
                        Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Advanced Notepad" Level="1">
      <ComponentRef Id="MainExecutable"/>
      <ComponentRef Id="NativeEngine"/>
      <ComponentRef Id="AppDependencies"/>
      <ComponentRef Id="ShellIntegration"/>
      <ComponentRef Id="StartMenuShortcut"/>
      <ComponentRef Id="DesktopShortcut"/>
    </Feature>

  </Package>
</Wix>