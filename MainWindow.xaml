<ui:FluentWindow x:Class="AdvancedNotepad.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:local="clr-namespace:AdvancedNotepad.App"
    Title="Advanced Notepad" Height="720" Width="1100"
    WindowBackdropType="Mica" WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <Style TargetType="TabItem" x:Key="ModernTab">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- TitleBar -->
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="*"/>      <!-- Tabs / Editor -->
            <RowDefinition Height="Auto"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Advanced Notepad" Icon="pack://application:,,,/app.ico"/>

        <ui:CommandBar Grid.Row="1" Visibility="{Binding IsZenMode, Converter={StaticResource InverseBoolToVis}}">
            <ui:Button Content="New" Icon="{ui:SymbolIcon DocumentAdd24}" Command="{Binding NewTabCommand}" ToolTip="Ctrl+N"/>
            <ui:Button Content="Open" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenFileCommand}" ToolTip="Ctrl+O"/>
            <ui:Button Content="Save" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" ToolTip="Ctrl+S"/>
            <Separator/>
            <ui:Button Content="Find/Replace" Icon="{ui:SymbolIcon Search24}" Command="{Binding ToggleFindReplaceCommand}" ToolTip="Ctrl+H"/>
            <ui:ToggleButton Content="Word Wrap" IsChecked="{Binding WordWrap}"/>
            <ui:ToggleButton Content="Markdown Preview" IsChecked="{Binding MarkdownPreview}"/>
            <ui:Button Content="Zen Mode" Icon="{ui:SymbolIcon FullScreenMaximize24}" Command="{Binding ToggleZenModeCommand}" ToolTip="F11"/>
        </ui:CommandBar>

        <Grid Grid.Row="2">
            <TabControl x:Name="EditorTabs" ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding ActiveTab}"
                        ItemContainerStyle="{StaticResource ModernTab}"
                        AllowDrop="True"
                        PreviewMouseMove="EditorTabs_TabDragReorder">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}"/>
                            <TextBlock Text="*" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" Margin="4,0,0,0"/>
                            <ui:Button Icon="{ui:SymbolIcon Dismiss16}" Width="20" Height="20" Margin="6,0,0,0"
                                       Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                       CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{Binding MarkdownPaneWidth}"/>
                            </Grid.ColumnDefinitions>
                            <avalonEdit:TextEditor x:Name="Editor"
                                FontFamily="Cascadia Code" FontSize="{Binding FontSize}"
                                ShowLineNumbers="{Binding ShowLineNumbers}"
                                WordWrap="{Binding WordWrap}"
                                Document="{Binding Document, Mode=TwoWay}"
                                SyntaxHighlighting="{Binding HighlightingDef}"/>
                            <Border Grid.Column="1" Visibility="{Binding ShowMarkdownPane, Converter={StaticResource BoolToVis}}">
                                <local:MarkdownPreviewControl Markdown="{Binding PlainText}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <local:FindReplacePanel x:Name="FindReplace" VerticalAlignment="Top" HorizontalAlignment="Right"
                                     Visibility="{Binding IsFindReplaceOpen, Converter={StaticResource BoolToVis}}"
                                     DataContext="{Binding FindReplaceVM}" Margin="0,8,16,0"/>
        </Grid>

        <ui:StatusBar Grid.Row="3" Visibility="{Binding IsZenMode, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="{Binding ActiveTab.LineCount, StringFormat='Ln {0}'}"/>
            <TextBlock Text="{Binding ActiveTab.CaretColumn, StringFormat='Col {0}'}" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding ActiveTab.WordCount, StringFormat='{}{0} words'}" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding ActiveTab.CharCount, StringFormat='{}{0} chars'}" Margin="12,0,0,0"/>
            <ComboBox ItemsSource="{Binding EncodingOptions}" SelectedItem="{Binding ActiveTab.Encoding}" Margin="12,0,0,0"/>
            <Slider Minimum="50" Maximum="300" Value="{Binding ZoomPercent}" Width="100" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding ZoomPercent, StringFormat='{}{0}%'}"/>
        </ui:StatusBar>
    </Grid>
</ui:FluentWindow>